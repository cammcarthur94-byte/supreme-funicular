# ==============================================================================
# SHOPIFY RAFFLE APP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholders with your actual secrets.
# NEVER commit .env or real credentials to source control.
# ==============================================================================

# Public values (Safe in docs and repository)
SUPABASE_URL=https://lpdgrgkutafrbsrvgakz.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_3E2HorJYDSpjspNqx3a9Dw_Xj2aQ8-Q
SHOPIFY_API_KEY=5659eb40af5e9670a92743f7c578e2fe

# Supabase Postgres credentials (SECRET: put real values in local .env only)
# Direct connection (port 5432) - Used ONLY by Prisma Migrate:
DIRECT_URL=postgresql://postgres.lpdgrgkutafrbsrvgakz:<DB_PASSWORD>@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Pooled connection (port 6543) - Used by Prisma Client at runtime:
DATABASE_URL=postgresql://postgres.lpdgrgkutafrbsrvgakz:<DB_PASSWORD>@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Shopify App credentials & configuration
SHOPIFY_API_SECRET=<SHOPIFY_CLIENT_SECRET>
SHOPIFY_APP_URL=<set by the Shopify CLI tunnel in dev; host URL in production>
SCOPES=read_products,write_products,read_customers,write_draft_orders,read_orders

# Application Security & Bot Protection (Phases 2 & 7)
ENCRYPTION_MASTER_KEY=<generate with: openssl rand -base64 32>
TURNSTILE_SITE_KEY=<Cloudflare Turnstile site key, public>
TURNSTILE_SECRET_KEY=<Cloudflare Turnstile secret key>

# Upstash Redis & QStash (Serverless background tasks & rate limiting)
UPSTASH_REDIS_REST_URL=<Upstash Redis REST URL>
UPSTASH_REDIS_REST_TOKEN=<Upstash Redis REST token>
QSTASH_TOKEN=<Upstash QStash token>
QSTASH_CURRENT_SIGNING_KEY=<Upstash QStash current signing key>
QSTASH_NEXT_SIGNING_KEY=<Upstash QStash next signing key>

# Background backstop cron & Transactional Email
CRON_SECRET=<generate with: openssl rand -hex 32>
EMAIL_API_KEY=<Resend API key>
