{% assign raffle_id = block.settings.draw_id | strip %}
<div
  class="fairdrops-entry"
  data-fairdrops-entry
  data-draw-id="{{ raffle_id | escape }}"
  data-rules-url="{{ block.settings.rules_url | escape }}"
  {{ block.shopify_attributes }}
>
  {% if raffle_id == blank %}
    <p>Select a draw ID in this block's settings to display its entry form.</p>
  {% else %}
    <p data-entry-status role="status" aria-live="polite">Loading draw…</p>
    <div data-entry-content hidden>
      <h2 data-draw-title></h2>
      <p data-countdown></p>
      <div data-requirements></div>
      <a data-official-rules target="_blank" rel="noopener noreferrer" hidden>Official rules</a>
      <p data-customer-message></p>
      <a data-login-link href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}" hidden>Log in / create account to enter</a>
      <button type="button" data-entry-button disabled>Enter this draw</button>
    </div>
  {% endif %}
</div>

{% if raffle_id != blank %}
  <script src="{{ 'raffle-entry.js' | asset_url }}" defer></script>
  <link rel="stylesheet" href="{{ 'raffle-entry.css' | asset_url }}">
{% endif %}

{% schema %}
{
  "name": "Raffle Entry",
  "target": "section",
  "stylesheet": "raffle-entry.css",
  "settings": [
    { "type": "text", "id": "draw_id", "label": "Draw ID", "info": "Copy the draw ID from Fairdrops in your app admin." },
    { "type": "url", "id": "rules_url", "label": "Official rules link" }
  ]
}
{% endschema %}
