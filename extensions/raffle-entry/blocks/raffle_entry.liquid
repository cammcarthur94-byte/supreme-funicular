{% assign raffle_id = block.settings.draw_id | default: section.settings.draw_id %}
{% if raffle_id == blank %}
  {% assign raffle_id = "latest" %}
{% endif %}
{% assign rules_url = block.settings.rules_url | default: section.settings.rules_url %}

<div
  class="fairdrops-entry"
  data-fairdrops-entry
  data-draw-id="{{ raffle_id | escape }}"
  data-rules-url="{{ rules_url | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="fairdrops-card">
    <div class="fairdrops-selector-wrapper" data-draw-selector-wrapper style="display: none;">
      <label class="fairdrops-selector-label">Select Raffle Drop:</label>
      <select class="fairdrops-select" data-draw-select>
        <option value="">Loading raffles...</option>
      </select>
    </div>

    <div class="fairdrops-header">
      <span class="fairdrops-badge" data-draw-status>RAFFLE DROP</span>
      <span class="fairdrops-countdown" data-countdown>Entries open soon</span>
    </div>

    <h2 class="fairdrops-title" data-draw-title>The Complete Snowboard Raffle Drop</h2>

    <div class="fairdrops-requirements-box">
      <h4 class="fairdrops-requirements-heading">Eligibility Requirements</h4>
      <div data-requirements>
        <ul class="fairdrops-rules-list">
          <li>Verified customer email required</li>
          <li>Eligible shipping countries: Canada, United States</li>
        </ul>
      </div>
      <a data-official-rules class="fairdrops-rules-link" target="_blank" rel="noopener noreferrer" hidden>Official rules</a>
    </div>

    <div class="fairdrops-action-box">
      <!-- Anti-Bot Honeypot -->
      <div style="position: absolute; left: -9999px; top: -9999px; opacity: 0; pointer-events: none;" aria-hidden="true">
        <input type="text" name="website_hp_check" tabindex="-1" autocomplete="off" value="" data-fairdrops-honeypot>
      </div>

      <!-- Cloudflare Turnstile Container -->
      <div class="fairdrops-turnstile-container" data-turnstile-container style="margin: 12px 0;"></div>

      <div data-customer-message class="fairdrops-message" style="display: none;"></div>

      {% if customer %}
        <div class="fairdrops-customer-badge">
          <span class="fairdrops-customer-icon">👤</span>
          <span>Logged in as <strong>{{ customer.email | escape }}</strong></span>
        </div>
        <div
          data-customer-meta
          data-email="{{ customer.email | escape }}"
          data-verified="true"
          data-country="{{ customer.default_address.country_code | default: customer.addresses.first.country_code | default: shop.country_code }}"
          data-created="{{ customer.created_at | date: '%Y-%m-%d' }}"
          data-phone="{{ customer.phone }}"
          hidden
        ></div>
        <button type="button" data-entry-button class="fairdrops-submit-btn">
          <span class="fairdrops-btn-spinner" data-btn-spinner style="display: none;"></span>
          <span data-btn-text>Enter This Draw</span>
        </button>
      {% else %}
        <div class="fairdrops-login-prompt">
          <p class="fairdrops-login-desc">Sign in with your customer account to submit your verified raffle entry.</p>
          <a data-login-link class="fairdrops-login-btn" href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}">
            Log in / Create account to enter
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
<script src="{{ 'raffle-entry.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'raffle-entry.css' | asset_url }}">

{% schema %}
{
  "name": "Raffle Entry",
  "target": "section",
  "stylesheet": "raffle-entry.css",
  "settings": [
    { "type": "text", "id": "draw_id", "label": "Draw ID", "info": "Leave blank to automatically display your store's latest active raffle drop." },
    { "type": "url", "id": "rules_url", "label": "Official rules link" }
  ]
}
{% endschema %}
